---
import BaseLayout from "../layouts/BaseLayout.astro";
import AccountPanel from "../components/cloud/AccountPanel";
import BackupControls from "../components/settings/BackupControls";
---

<BaseLayout title="Ajustes">
	<h1 class="text-2xl font-semibold">Ajustes</h1>
	<p class="mt-1 text-zinc-500 dark:text-zinc-400">
		Vincula tus dispositivos y conserva un respaldo de tu progreso.
	</p>
	<div class="mt-6">
		<AccountPanel client:only="react" />
		<BackupControls client:only="react" />
	</div>
</BaseLayout>
