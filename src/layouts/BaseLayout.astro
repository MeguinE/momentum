---
import CloudStatus from '../components/cloud/CloudStatus';
import ThemeToggle from '../components/ui/ThemeToggle';
import LearningInit from '../components/learning/LearningInit';
import { LayoutDashboard, ListChecks, CalendarDays, ChartNoAxesCombined, Settings2, Route, Sprout, ArrowUpRight } from 'lucide-react';
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
const items = [
  { href: '/', label: 'Mi día', icon: LayoutDashboard },
  { href: '/habits', label: 'Mis hábitos', icon: ListChecks },
  { href: '/learning', label: 'Aprendizaje', icon: Route },
  { href: '/calendar', label: 'Calendario', icon: CalendarDays },
  { href: '/stats', label: 'Estadísticas', icon: ChartNoAxesCombined },
  { href: '/settings', label: 'Ajustes', icon: Settings2 },
];
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    (function () { var stored; try { stored = localStorage.getItem('habit-tracker:theme'); } catch {} var dark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches); document.documentElement.classList.toggle('dark', dark); })();
  </script>
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Tu espacio para construir hábitos, aprender idiomas y crecer como desarrollador. Un pequeño paso, cada día." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} · Momentum</title>
</head>
<body>
  <a class="skip-link" href="#main">Saltar al contenido</a>
  <aside class="sidebar">
    <a href="/" class="brand"><span class="brand-icon"><Sprout size={25}/></span><span>momentum<span class="brand-dot">.</span><small>PEQUEÑOS PASOS. GRANDES CAMBIOS.</small></span></a>
    <p class="nav-caption">TU ESPACIO</p>
    <nav aria-label="Principal"><ul>{items.map(item => <li><a href={item.href} aria-current={Astro.url.pathname.replace(/\/$/, '') === item.href.replace(/\/$/, '') ? 'page' : undefined}><item.icon size={19}/><span>{item.label}</span>{item.href === '/learning' && <span class="new-badge">3</span>}</a></li>)}</ul></nav>
    <div class="sidebar-bottom"><div class="growth-note"><Sprout size={26}/><p>No necesitas hacerlo perfecto.</p><strong>Solo dar el siguiente paso.</strong><a href="/learning">Encuentra tu siguiente paso <ArrowUpRight size={15}/></a></div><div class="profile"><span>G</span><div><strong>Mi espacio personal</strong><small>Construyendo mi mejor versión</small></div></div></div>
  </aside>
  <div class="workspace"><header class="topbar"><span>Mi espacio <span class="breadcrumb">/</span> <strong>{title}</strong></span><div class="topbar-actions"><CloudStatus client:only="react"/><ThemeToggle client:only="react"/></div></header><main id="main"><LearningInit client:only="react"/><slot /></main><footer class="app-footer">Cada pequeño avance cuenta. <span>Hecho para tu ritmo.</span></footer></div>
</body>
</html>
